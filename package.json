{
  "name": "lovelace-multi-button-card",
  "version": "1.9.0-beta.7",
  "description": "Multi-button control card for Home Assistant, tuned for wall-mounted dashboards",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julezdean/lovelace-multi-button-card.git"
  },
  "homepage": "https://github.com/julezdean/lovelace-multi-button-card#readme",
  "bugs": {
    "url": "https://github.com/julezdean/lovelace-multi-button-card/issues"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts,.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "npm run format:check && npm run lint && npm run build && npm test",
    "screenshots": "npm run build && ./tools/screenshots.sh",
    "icons": "node tools/build-demo-icons.js"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
